# ===================================================================
# Apache Configuration for InfinityFree (PHP + MySQL + React SPA)
# ===================================================================
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Pass authorization and custom security headers to PHP environment
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
  RewriteRule .* - [E=HTTP_X_ADMIN_KEY:%{HTTP:x-admin-key}]
  RewriteRule .* - [E=HTTP_X_APP_KEY:%{HTTP:x-app-key}]

  # Proxy /api requests to PHP API backend if Node server is not active
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^api/(.*)$ api.php?endpoint=$1 [QSA,L]

  # Allow direct access to admin portal URL, nationalists, and community
  RewriteRule ^v7/admin/om/?$ index.html [L,QSA]
  RewriteRule ^nationalists/?$ index.html [L,QSA]
  RewriteRule ^community(.*)$ index.html [L,QSA]

  # Block direct access to database credentials, SQL dumps, and SQLite DBs
  <FilesMatch "^(db_config\.php|.*\.sql|.*\.db|.*\.sqlite)$">
    Order Allow,Deny
    Deny from all
  </FilesMatch>

  # Existing files and directories serve normally
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # All other routes rewrite to index.html for React SPA
  RewriteRule ^ index.html [L]
</IfModule>

# Disable directory listing
Options -Indexes

# Security & CORS headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Access-Control-Allow-Origin "*"
  Header set Access-Control-Allow-Methods "GET, POST, PUT, PATCH, DELETE, OPTIONS"
  Header set Access-Control-Allow-Headers "Content-Type, Authorization, x-admin-key, X-Admin-Key, x-app-key, X-App-Key, x-client-key, X-Client-Key, X-HTTP-Method-Override, X-EP-Timestamp, X-EP-Signature"
</IfModule>
